{
  "name": "google-videos-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vidora — buscador y reproductor de videos de Google en tiempo real (React + Vite frontend, Express + SerpApi backend).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "server": "npm --prefix server start",
    "dev:all": "concurrently -n web,api -c blue,magenta \"npm run dev\" \"npm run server\""
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.0"
  },
  "keywords": ["react", "vite", "serpapi", "google-videos", "video-search"],
  "author": "",
  "license": "ISC"
}
